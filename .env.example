# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the public booking page and the Google Calendar connection.
SUPABASE_SERVICE_ROLE_KEY=

# The URL the app is served from, no trailing slash (e.g. https://pm.contourdigital.com.au)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
